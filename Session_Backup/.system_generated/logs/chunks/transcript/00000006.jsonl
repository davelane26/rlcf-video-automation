ineItems[i]:SetClipColor(\"Orange\")\n97:                 end\n98:             end)\n99:         end\n100: \n101:         currentFrameOffset = currentFrameOffset + durFrames\n102:     end\n103:     print(\"SUCCESS: Created 'RLCF Sunday - 5 Worship Songs' with official titles!\")\n104: end\n105: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
